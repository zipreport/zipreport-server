# Base image is pinned by digest; Dependabot (docker ecosystem) bumps the digest.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:0feab531471d2edfcca55f18883441cb7df598e724fa2dedf9985273f532eed7

# Go toolchain + git for module fetches, plus Chromium runtime libraries.
# Package set mirrors the runtime Dockerfile.
RUN apk add --no-cache \
    go-1.27 \
    git \
    libnss \
    libudev \
    libxscrnsaver \
    libxtst \
    libxcomposite \
    libxdamage \
    libxrandr \
    libxkbcommon \
    libx11 \
    libdrm \
    mesa-gbm \
    gtk-3 \
    pango \
    cups-libs \
    at-spi2-core \
    dbus-libs \
    alsa-lib \
    ca-certificates-bundle \
    font-liberation \
    font-noto-emoji \
    font-noto-cjk \
    tzdata

ENV PATH="/usr/lib/go-1.27/bin:${PATH}"

WORKDIR /app

# Cache dependency downloads
COPY go.mod go.sum ./
RUN go mod download

# Fetch Chrome before copying the rest of the source, so a source change does not download it again
COPY cmd/browser-update ./cmd/browser-update
COPY pkg/browser ./pkg/browser
RUN go build -ldflags="-s -w" -o browser-update ./cmd/browser-update/main.go && \
    ./browser-update

COPY . .

# Mark as Docker environment for --no-sandbox detection
RUN touch /.dockerenv

CMD ["go", "test", "-v", "-p", "1", "-timeout=10m", "./test/...", "./internal/...", "./pkg/..."]
